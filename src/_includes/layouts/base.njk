<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.nome }} — {{ site.programa }}/{{ site.instituicao }}</title>
  <meta name="description" content="{{ descricao or (site.nomeCompleto + ' do ' + site.programaCompleto + ', ' + site.instituicao + '.') }}">
  <link rel="icon" href="{{ '/favicon.svg' | rel }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/css/style.css' | rel }}">
</head>
<body{% if corpoClasse %} class="{{ corpoClasse }}"{% endif %}>
  {% include "partials/nav.njk" %}

  <main>
    {{ content | safe }}
  </main>

  <footer class="rodape">
    <div class="container">
      <div class="logos-institucionais" aria-label="Instituições vinculadas">
        <img src="{{ '/assets/logos/logo-ufmg.svg' | rel }}" alt="UFMG">
        <img src="{{ '/assets/logos/logo-ppgmus.jpeg' | rel }}" alt="PPGMUS" style="height:2.2rem;">
        <img src="{{ '/assets/logos/logo-emus100.png' | rel }}" alt="Escola de Música UFMG — 100 anos">
        <img src="{{ '/assets/logos/logo-capes.svg' | rel }}" alt="CAPES">
      </div>
      <p>
        {{ site.nomeCompleto }} ({{ site.nome }}) — {{ site.programaCompleto }} ({{ site.programa }}),
        {{ site.instituicaoCompleta }} ({{ site.instituicao }}).
      </p>
      <p>Contato: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
  </footer>

  <script>
    // Enquanto true, o auto-hide do cabeçalho (mais abaixo) fica em pausa.
    // Evita que, ao pular para uma âncora (#programacao etc.), o cabeçalho
    // suma bem no momento em que a seção alvo chega ao topo — o que
    // deixaria à mostra um pedaço da seção anterior no espaço reservado
    // pelo scroll-margin-top da seção (pensado para o cabeçalho, visível,
    // cobrir esse espaço).
    var suprimirAutoHideCabecalho = false;
    function pausarAutoHideCabecalho() {
      suprimirAutoHideCabecalho = true;
      var cabecalho = document.querySelector(".cabecalho");
      if (cabecalho) cabecalho.classList.remove("escondido");

      var liberar = function () {
        suprimirAutoHideCabecalho = false;
        window.removeEventListener("scrollend", liberar);
      };
      if ("onscrollend" in window) {
        window.addEventListener("scrollend", liberar, { once: true });
      } else {
        // Navegadores sem "scrollend": tempo generoso para uma rolagem
        // suave (scroll-behavior: smooth) terminar.
        setTimeout(liberar, 1000);
      }
    }

    // Acesso direto via #hash (ex.: link para #programacao): pula a
    // animação de abertura do logo/foto e deixa cabeçalho e foto já no
    // estado final, sem transição.
    (function () {
      if (!window.location.hash) return;
      pausarAutoHideCabecalho();

      var elementosSemAnimacao = [
        document.querySelector(".cabecalho"),
        document.querySelector(".hero--media"),
      ].filter(Boolean);
      elementosSemAnimacao.forEach(function (el) { el.classList.add("sem-transicao"); });

      if (typeof window.iniciarFaseFoto === "function") {
        window.iniciarFaseFoto();
      }

      // O carregamento inicial via #hash nem sempre é rolado pelo próprio
      // navegador até o alvo (o layout do herói — foto, texto — ainda está
      // se acomodando nesse instante). Duas frames garantem que o estado
      // "revelado" já foi pintado sem transição antes de rolar e de voltar
      // a permitir transições normais (ex.: o cabeçalho some/aparece ao
      // rolar a página) — uma só chamada de scroll, sem behavior:smooth,
      // para não haver um salto visível entre uma rolagem parcial e outra.
      var alvoAncora = document.querySelector(window.location.hash);
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          elementosSemAnimacao.forEach(function (el) { el.classList.remove("sem-transicao"); });
          if (alvoAncora) alvoAncora.scrollIntoView({ behavior: "instant", block: "start" });
        });
      });
    })();

    // Clique em qualquer link interno para uma âncora (ex.: "Programação"
    // no menu): mesma pausa do auto-hide, para o cabeçalho não sumir
    // durante a rolagem suave até lá.
    document.addEventListener("click", function (evento) {
      var link = evento.target.closest('a[href^="#"]');
      if (link) pausarAutoHideCabecalho();
    });

    // Revela elementos com a classe "reveal-scroll" (ex.: a tabela de
    // programação) com um fade + leve deslocamento assim que entram na tela.
    (function () {
      var elementos = document.querySelectorAll(".reveal-scroll");
      if (!elementos.length) return;

      // Acesso direto via #hash (ex.: vindo de um link para #programacao):
      // exibe o conteúdo já revelado, sem tocar a animação de entrada.
      var alvoHash = window.location.hash
        ? document.querySelector(window.location.hash)
        : null;

      var observador = new IntersectionObserver(
        function (entradas) {
          entradas.forEach(function (entrada) {
            if (entrada.isIntersecting) {
              entrada.target.classList.add("visivel");
              observador.unobserve(entrada.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      elementos.forEach(function (el) {
        if (alvoHash && (el === alvoHash || alvoHash.contains(el))) {
          el.classList.add("sem-transicao", "visivel");
        } else {
          observador.observe(el);
        }
      });
    })();

    // Menu (versão web/desktop): some ao rolar para baixo, volta ao rolar
    // para cima ou ao chegar perto do topo — padrão comum de header
    // "auto-hide". No mobile o menu segue outra lógica (ver .menu-toggle
    // / .pagina-inicial .cabecalho), então isso só faz efeito em telas
    // largas (ver a media query em style.css).
    (function () {
      var cabecalho = document.querySelector(".cabecalho");
      if (!cabecalho) return;
      var ultimoY = window.scrollY;
      window.addEventListener(
        "scroll",
        function () {
          var atualY = window.scrollY;
          if (suprimirAutoHideCabecalho) {
            cabecalho.classList.remove("escondido");
          } else if (atualY <= 80) {
            cabecalho.classList.remove("escondido");
          } else if (atualY > ultimoY) {
            cabecalho.classList.add("escondido");
          } else {
            cabecalho.classList.remove("escondido");
          }
          ultimoY = atualY;
        },
        { passive: true }
      );
    })();
  </script>
</body>
</html>
